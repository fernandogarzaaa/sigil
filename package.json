  "main": "./dist/index.js",
  "name": "sigil-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandogarzaaa/sigil.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
